{
  "expo": {
    "name": "QRTT_APP",
    "slug": "QRTT_APP",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon2.png",
    "scheme": "qrttapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon2.png"
    },
    "android": {
      "package": "com.anonymous.QRTT_APP",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#041420",
        "foregroundImage": "./assets/images/icon2.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow QRTT to scan event QR codes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#041420",
          "image": "./assets/images/icon2.png",
          "imageWidth": 180
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow QRTT to verify you are at the event venue when checking in."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e0087023-aa6c-4298-b75e-fdab321286ea"
      }
    }
  }
}
